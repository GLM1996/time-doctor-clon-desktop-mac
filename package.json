{
  "name": "log-your-time-mac-prototype",
  "version": "1.2.7",
  "description": "Prototipo macOS aislado de LogYourTime",
  "main": "./bootstrap.cjs",
  "type": "module",
  "author": "Gustavo Leon",
  "build": {
    "appId": "com.homelasvegasnevada.logyourtime.macprototype",
    "productName": "LogYourTime Mac Prototype",
    "directories": {
      "output": "release-mac"
    },
    "files": [
      "out/**/*",
      "package.json",
      "bootstrap.cjs"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/get-windows/**",
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "LogYourTime consulta el dominio del navegador activo para registrar la actividad autorizada.",
        "NSScreenCaptureUsageDescription": "LogYourTime captura la pantalla durante una jornada autorizada."
      }
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=35 --test-coverage-functions=90 --test-concurrency=1",
    "pack": "npm run build && electron-builder --mac --dir --publish never",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "smoke:mac": "node scripts/smoke-mac.mjs"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.3.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "form-data": "^4.0.6",
    "get-windows": "^9.3.0",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
